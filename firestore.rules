rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // COMMON
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "uid",
          "photoUrl",
          "fcmToken"
        ])
        && request.resource.data.keys().hasAll([
          "name",
          "email",
          "uid"
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && (
          !request.resource.data.keys().hasAny(["photoUrl"])
          || request.resource.data.photoUrl is string
        )
        && (
          !request.resource.data.keys().hasAny(["fcmToken"])
          || request.resource.data.fcmToken is string
        );

      allow update: if signedIn()
        && request.auth.uid == userId
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "uid",
          "photoUrl",
          "fcmToken"
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.uid is string
        && (
          !request.resource.data.keys().hasAny(["photoUrl"])
          || request.resource.data.photoUrl is string
        )
        && (
          !request.resource.data.keys().hasAny(["fcmToken"])
          || request.resource.data.fcmToken is string
        );

      allow delete: if isOwner(userId)
        && resource.data.uid == request.auth.uid;
    }


    // =========================================================
    // SERVICES
    // =========================================================

    match /services/{serviceId} {

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "name",
          "profession",
          "description",
          "price",
          "priceType",
          "rating",
          "ratingCount",
          "userId",
          "tags",
          "createdAt",
          "imageUrl",
          "country",
          "city"
        ])
        && request.resource.data.keys().hasAll([
          "name",
          "profession",
          "description",
          "price",
          "priceType",
          "rating",
          "ratingCount",
          "userId",
          "tags",
          "createdAt",
          "imageUrl"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.profession is string
        && request.resource.data.description is string
        && request.resource.data.price is string
        && request.resource.data.priceType is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingCount >= 0
        && request.resource.data.tags is list
        && request.resource.data.createdAt is int
        && (
          request.resource.data.imageUrl == null
          || request.resource.data.imageUrl is string
        )
        && (
          !request.resource.data.keys().hasAny(["country"])
          || request.resource.data.country is string
        )
        && (
          !request.resource.data.keys().hasAny(["city"])
          || request.resource.data.city is string
        );

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.keys().hasOnly([
          "name",
          "profession",
          "description",
          "price",
          "priceType",
          "rating",
          "ratingCount",
          "userId",
          "tags",
          "createdAt",
          "imageUrl",
          "country",
          "city",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.profession is string
        && request.resource.data.description is string
        && request.resource.data.price is string
        && request.resource.data.priceType is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingCount >= 0
        && request.resource.data.tags is list
        && request.resource.data.createdAt is int
        && (
          request.resource.data.imageUrl == null
          || request.resource.data.imageUrl is string
        )
        && (
          !request.resource.data.keys().hasAny(["country"])
          || request.resource.data.country is string
        )
        && (
          !request.resource.data.keys().hasAny(["city"])
          || request.resource.data.city is string
        )
        && (
          !request.resource.data.keys().hasAny(["updatedAt"])
          || request.resource.data.updatedAt is int
        );

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;


      // =======================================================
      // REVIEWS
      // =======================================================

      match /reviews/{reviewId} {

        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            "userId",
            "userName",
            "rating",
            "comment",
            "timestamp"
          ])
          && request.resource.data.keys().hasAll([
            "userId",
            "userName",
            "rating",
            "comment",
            "timestamp"
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userId !=
             get(
               /databases/$(database)/documents/services/$(serviceId)
             ).data.userId
          && request.resource.data.userName is string
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.timestamp is int;

        allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.keys().hasOnly([
            "userId",
            "userName",
            "rating",
            "comment",
            "timestamp"
          ])
          && request.resource.data.userName is string
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.timestamp is int;

        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }


    // =========================================================
    // CHAT ACCESS CONTROL
    // =========================================================
    //
    // IMPORTANT:
    //
    // These documents are server-managed.
    //
    // ensureChatParticipant Cloud Function uses Admin SDK
    // to create them.
    //
    // Client users have NO direct read/write access.
    //
    // Cloud Storage Rules use `exists()` against these docs
    // to authorize chat attachments.
    //

    match /chatAccess/{chatId}/participants/{userId} {

      allow read, write: if false;
    }


    // =========================================================
    // SERVICE REQUESTS
    // =========================================================

    match /serviceRequests/{requestId} {

      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.providerId == request.auth.uid
        );


      // -------------------------------------------------------
      // CREATE
      // -------------------------------------------------------

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "requestId",
          "serviceId",
          "customerId",
          "providerId",
          "status",
          "message",
          "requestedPrice",
          "priceType",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "requestId",
          "serviceId",
          "customerId",
          "providerId",
          "status",
          "message",
          "requestedPrice",
          "priceType",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.requestId == requestId
        && request.resource.data.serviceId is string
        && request.resource.data.customerId is string
        && request.resource.data.providerId is string
        && request.resource.data.status == "requested"
        && request.resource.data.message is string
        && request.resource.data.requestedPrice is string
        && request.resource.data.priceType is string
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.customerId != request.resource.data.providerId
        && get(
             /databases/$(database)/documents/services/$(request.resource.data.serviceId)
           ).data.userId == request.resource.data.providerId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;


      // -------------------------------------------------------
      // REQUESTED -> ACCEPTED
      // -------------------------------------------------------

      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && resource.data.status == "requested"
        && request.resource.data.status == "accepted"
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               "status",
               "acceptedAt",
               "updatedAt"
             ])
        && request.resource.data.acceptedAt is timestamp
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;


      // -------------------------------------------------------
      // REQUESTED -> REJECTED
      // -------------------------------------------------------

      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && resource.data.status == "requested"
        && request.resource.data.status == "rejected"
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               "status",
               "rejectedAt",
               "rejectionReason",
               "updatedAt"
             ])
        && request.resource.data.rejectedAt is timestamp
        && request.resource.data.rejectedAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (
          !request.resource.data.keys().hasAny(["rejectionReason"])
          || request.resource.data.rejectionReason is string
        );


      // -------------------------------------------------------
      // REQUESTED -> CANCELLED
      // -------------------------------------------------------

      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        && resource.data.status == "requested"
        && request.resource.data.status == "cancelled"
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               "status",
               "cancelledAt",
               "cancelledBy",
               "cancellationReason",
               "updatedAt"
             ])
        && request.resource.data.cancelledAt is timestamp
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.cancelledBy is string
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (
          !request.resource.data.keys().hasAny(["cancellationReason"])
          || request.resource.data.cancellationReason is string
        );


      // -------------------------------------------------------
      // ACCEPTED -> IN_PROGRESS
      // -------------------------------------------------------

      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && resource.data.status == "accepted"
        && request.resource.data.status == "in_progress"
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               "status",
               "startedAt",
               "updatedAt"
             ])
        && request.resource.data.startedAt is timestamp
        && request.resource.data.startedAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;


      // -------------------------------------------------------
      // ACCEPTED -> CANCELLED
      // -------------------------------------------------------

      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        && resource.data.status == "accepted"
        && request.resource.data.status == "cancelled"
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               "status",
               "cancelledAt",
               "cancelledBy",
               "cancellationReason",
               "updatedAt"
             ])
        && request.resource.data.cancelledAt is timestamp
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.cancelledBy is string
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (
          !request.resource.data.keys().hasAny(["cancellationReason"])
          || request.resource.data.cancellationReason is string
        );


      // -------------------------------------------------------
      // IN_PROGRESS -> COMPLETED
      // -------------------------------------------------------

      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && resource.data.status == "in_progress"
        && request.resource.data.status == "completed"
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               "status",
               "completedAt",
               "updatedAt"
             ])
        && request.resource.data.completedAt is timestamp
        && request.resource.data.completedAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;


      // -------------------------------------------------------
      // IN_PROGRESS -> CANCELLED
      // -------------------------------------------------------

      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        && resource.data.status == "in_progress"
        && request.resource.data.status == "cancelled"
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               "status",
               "cancelledAt",
               "cancelledBy",
               "cancellationReason",
               "updatedAt"
             ])
        && request.resource.data.cancelledAt is timestamp
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.cancelledBy is string
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (
          !request.resource.data.keys().hasAny(["cancellationReason"])
          || request.resource.data.cancellationReason is string
        );


      allow delete: if false;
    }


    // =========================================================
    // CALLS
    // =========================================================

    match /calls/{callId} {

      allow read: if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );


      // -------------------------------------------------------
      // INCOMING CALL
      // /calls/{calleeUid}
      // -------------------------------------------------------

      allow create: if signedIn()
        && callId == request.resource.data.calleeId
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.keys().hasOnly([
          "callId",
          "callerId",
          "calleeId",
          "callerName",
          "callerPhotoUrl",
          "channelName",
          "serviceTitle",
          "status"
        ])
        && request.resource.data.callId is string
        && request.resource.data.callerId is string
        && request.resource.data.calleeId is string
        && request.resource.data.callerName is string
        && request.resource.data.callerPhotoUrl is string
        && request.resource.data.channelName is string
        && request.resource.data.serviceTitle is string
        && request.resource.data.status == "ringing"
        && request.resource.data.channelName == request.resource.data.callId;


      // -------------------------------------------------------
      // CALLER STATE
      // /calls/{callerUid}
      // -------------------------------------------------------

      allow create: if signedIn()
        && callId == request.auth.uid
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.otherUserId == request.resource.data.calleeId
        && request.resource.data.keys().hasOnly([
          "callId",
          "callerId",
          "calleeId",
          "otherUserId",
          "channelName",
          "status"
        ])
        && request.resource.data.callId is string
        && request.resource.data.callerId is string
        && request.resource.data.calleeId is string
        && request.resource.data.otherUserId is string
        && request.resource.data.channelName is string
        && request.resource.data.status == "calling"
        && request.resource.data.channelName == request.resource.data.callId;


      // -------------------------------------------------------
      // CALL UPDATE
      // -------------------------------------------------------

      allow update: if signedIn()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "status"
             ])
        && (
          (
            resource.data.callerId == request.auth.uid
            && resource.data.status == "ringing"
            && request.resource.data.status == "cancelled"
          )
          ||
          (
            resource.data.calleeId == request.auth.uid
            && resource.data.status == "ringing"
            && request.resource.data.status == "accepted"
          )
          ||
          (
            resource.data.calleeId == request.auth.uid
            && resource.data.status == "ringing"
            && request.resource.data.status == "declined"
          )
          ||
          (
            resource.data.callerId == callId
            && resource.data.calleeId == request.auth.uid
            && resource.data.status == "calling"
            && request.resource.data.status == "accepted"
          )
          ||
          (
            resource.data.callerId == callId
            && resource.data.calleeId == request.auth.uid
            && resource.data.status == "calling"
            && request.resource.data.status == "declined"
          )
        );


      allow delete: if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );
    }


    // =========================================================
    // COMPLAINTS
    // =========================================================

    match /complaints/{complaintId} {

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "serviceId",
          "reporterId",
          "targetUserId",
          "reason",
          "timestamp"
        ])
        && request.resource.data.keys().hasAll([
          "serviceId",
          "reporterId",
          "targetUserId",
          "reason",
          "timestamp"
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.serviceId is string
        && request.resource.data.targetUserId is string
        && request.resource.data.reason is string
        && request.resource.data.timestamp is int
        && request.resource.data.targetUserId != request.auth.uid
        && get(
             /databases/$(database)/documents/services/$(request.resource.data.serviceId)
           ).data.userId == request.resource.data.targetUserId;

      allow read, update, delete: if false;
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}