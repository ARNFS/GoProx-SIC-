rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // COMMON
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // Current app needs authenticated users to read profiles.
      allow read: if signedIn();

      // User can create only his own profile.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "uid",
          "photoUrl",
          "fcmToken"
        ])
        && request.resource.data.keys().hasAll([
          "name",
          "email",
          "uid"
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && (
          !request.resource.data.keys().hasAny(["photoUrl"])
          || request.resource.data.photoUrl is string
        )
        && (
          !request.resource.data.keys().hasAny(["fcmToken"])
          || request.resource.data.fcmToken is string
        );

      // User may update only his own profile.
      // No ownership transfer.
      // No arbitrary new fields.
      allow update: if signedIn()
        && request.auth.uid == userId
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "uid",
          "photoUrl",
          "fcmToken"
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.uid is string
        && (
          !request.resource.data.keys().hasAny(["photoUrl"])
          || request.resource.data.photoUrl is string
        )
        && (
          !request.resource.data.keys().hasAny(["fcmToken"])
          || request.resource.data.fcmToken is string
        );

      allow delete: if isOwner(userId)
        && resource.data.uid == request.auth.uid;
    }

    // =========================================================
    // SERVICES
    // =========================================================

    match /services/{serviceId} {

      // Authenticated users can browse services.
      allow read: if signedIn();

      // Create service only for yourself.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "name",
          "profession",
          "description",
          "price",
          "priceType",
          "rating",
          "ratingCount",
          "userId",
          "tags",
          "createdAt",
          "imageUrl",
          "country",
          "city"
        ])
        && request.resource.data.keys().hasAll([
          "name",
          "profession",
          "description",
          "price",
          "priceType",
          "rating",
          "ratingCount",
          "userId",
          "tags",
          "createdAt",
          "imageUrl"
        ])
        && request.resource.data.userId == request.auth.uid

        && request.resource.data.name is string
        && request.resource.data.profession is string
        && request.resource.data.description is string
        && request.resource.data.price is string
        && request.resource.data.priceType is string

        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5

        && request.resource.data.ratingCount is int
        && request.resource.data.ratingCount >= 0

        && request.resource.data.tags is list
        && request.resource.data.createdAt is int

        && (
          request.resource.data.imageUrl == null
          || request.resource.data.imageUrl is string
        )

        && (
          !request.resource.data.keys().hasAny(["country"])
          || request.resource.data.country is string
        )

        && (
          !request.resource.data.keys().hasAny(["city"])
          || request.resource.data.city is string
        );

      // Only the service owner can update.
      // UserId cannot be changed.
      // No arbitrary field injection.
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId

        && request.resource.data.keys().hasOnly([
          "name",
          "profession",
          "description",
          "price",
          "priceType",
          "rating",
          "ratingCount",
          "userId",
          "tags",
          "createdAt",
          "imageUrl",
          "country",
          "city",
          "updatedAt"
        ])

        && request.resource.data.name is string
        && request.resource.data.profession is string
        && request.resource.data.description is string
        && request.resource.data.price is string
        && request.resource.data.priceType is string

        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5

        && request.resource.data.ratingCount is int
        && request.resource.data.ratingCount >= 0

        && request.resource.data.tags is list
        && request.resource.data.createdAt is int

        && (
          request.resource.data.imageUrl == null
          || request.resource.data.imageUrl is string
        )

        && (
          !request.resource.data.keys().hasAny(["country"])
          || request.resource.data.country is string
        )

        && (
          !request.resource.data.keys().hasAny(["city"])
          || request.resource.data.city is string
        )

        && (
          !request.resource.data.keys().hasAny(["updatedAt"])
          || request.resource.data.updatedAt is int
        );

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      // =======================================================
      // REVIEWS
      // =======================================================

      match /reviews/{reviewId} {

        allow read: if signedIn();

        // Review must come from the authenticated user.
        // Cannot review your own service.
        // Exact fields only.
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            "userId",
            "userName",
            "rating",
            "comment",
            "timestamp"
          ])
          && request.resource.data.keys().hasAll([
            "userId",
            "userName",
            "rating",
            "comment",
            "timestamp"
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userId !=
             get(
               /databases/$(database)/documents/services/$(serviceId)
             ).data.userId

          && request.resource.data.userName is string
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.timestamp is int;

        // A reviewer may edit only his own review.
        allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.keys().hasOnly([
            "userId",
            "userName",
            "rating",
            "comment",
            "timestamp"
          ])
          && request.resource.data.userName is string
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.timestamp is int;

        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    // =========================================================
    // CALLS
    // =========================================================

    match /calls/{callId} {

      // Only caller or callee can read a call document.
      allow read: if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );

      // -------------------------------------------------------
      // Incoming-call document
      //
      // /calls/{calleeUid}
      // -------------------------------------------------------

      allow create: if signedIn()
        && callId == request.resource.data.calleeId
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId != request.auth.uid

        && request.resource.data.keys().hasOnly([
          "callId",
          "callerId",
          "calleeId",
          "callerName",
          "callerPhotoUrl",
          "channelName",
          "serviceTitle",
          "status"
        ])

        && request.resource.data.callId is string
        && request.resource.data.callerId is string
        && request.resource.data.calleeId is string
        && request.resource.data.callerName is string
        && request.resource.data.callerPhotoUrl is string
        && request.resource.data.channelName is string
        && request.resource.data.serviceTitle is string
        && request.resource.data.status == "ringing"

        && request.resource.data.channelName ==
           request.resource.data.callId;

      // -------------------------------------------------------
      // Caller-state document
      //
      // /calls/{callerUid}
      // -------------------------------------------------------

      allow create: if signedIn()
        && callId == request.auth.uid
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.otherUserId ==
           request.resource.data.calleeId

        && request.resource.data.keys().hasOnly([
          "callId",
          "callerId",
          "calleeId",
          "otherUserId",
          "channelName",
          "status"
        ])

        && request.resource.data.callId is string
        && request.resource.data.callerId is string
        && request.resource.data.calleeId is string
        && request.resource.data.otherUserId is string
        && request.resource.data.channelName is string
        && request.resource.data.status == "calling"

        && request.resource.data.channelName ==
           request.resource.data.callId;

      // -------------------------------------------------------
      // UPDATE
      //
      // Only status can ever change.
      // -------------------------------------------------------

      allow update: if signedIn()

        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "status"
             ])

        && (

          // Caller cancels:
          // ringing -> cancelled
          (
            resource.data.callerId == request.auth.uid
            && resource.data.status == "ringing"
            && request.resource.data.status == "cancelled"
          )

          ||

          // Callee accepts:
          // ringing -> accepted
          (
            resource.data.calleeId == request.auth.uid
            && resource.data.status == "ringing"
            && request.resource.data.status == "accepted"
          )

          ||

          // Callee declines:
          // ringing -> declined
          (
            resource.data.calleeId == request.auth.uid
            && resource.data.status == "ringing"
            && request.resource.data.status == "declined"
          )

          ||

          // Callee updates caller-state:
          // calling -> accepted
          (
            resource.data.callerId == callId
            && resource.data.calleeId == request.auth.uid
            && resource.data.status == "calling"
            && request.resource.data.status == "accepted"
          )

          ||

          // Callee updates caller-state:
          // calling -> declined
          (
            resource.data.callerId == callId
            && resource.data.calleeId == request.auth.uid
            && resource.data.status == "calling"
            && request.resource.data.status == "declined"
          )
        );

      // Either participant may remove call state.
      // Needed by current call cleanup/end-call flow.
      allow delete: if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );
    }

    // =========================================================
    // COMPLAINTS
    // =========================================================

    match /complaints/{complaintId} {

      // User can submit a complaint only as himself.
      // targetUserId must actually be the owner of the reported service.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "serviceId",
          "reporterId",
          "targetUserId",
          "reason",
          "timestamp"
        ])
        && request.resource.data.keys().hasAll([
          "serviceId",
          "reporterId",
          "targetUserId",
          "reason",
          "timestamp"
        ])

        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.serviceId is string
        && request.resource.data.targetUserId is string
        && request.resource.data.reason is string
        && request.resource.data.timestamp is int

        && request.resource.data.targetUserId != request.auth.uid

        && get(
             /databases/$(database)/documents/services/$(request.resource.data.serviceId)
           ).data.userId == request.resource.data.targetUserId;

      // Complaints are private/admin-side.
      allow read, update, delete: if false;
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}