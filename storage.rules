rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================
    // PROFILE PHOTOS
    // =========================================================

    match /profile_photos/{fileName} {

      allow read: if request.auth != null;

      allow write: if request.auth != null
      && request.resource != null
      && request.resource.size < 5 * 1024 * 1024
      && request.resource.contentType != null
      && request.resource.contentType.matches('image/.*');
    }


    // =========================================================
    // SERVICE IMAGES
    // Path: service_images/{userId}/{fileName}
    // =========================================================

    match /service_images/{userId}/{fileName} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
      && request.auth.uid == userId
      && request.resource != null
      && request.resource.size <= 5 * 1024 * 1024
      && request.resource.contentType != null
      && request.resource.contentType.matches(
        'image/(jpeg|jpg|png|webp)'
      );

      allow update: if request.auth != null
      && request.auth.uid == userId
      && request.resource != null
      && request.resource.size <= 5 * 1024 * 1024
      && request.resource.contentType != null
      && request.resource.contentType.matches(
        'image/(jpeg|jpg|png|webp)'
      );

      allow delete: if request.auth != null
      && request.auth.uid == userId;
    }


    // =========================================================
    // CHAT ATTACHMENTS
    // =========================================================

    match /chat_attachments/{chatId}/{fileName} {

      allow read: if request.auth != null
      && firestore.exists(
        /databases/(default)/documents/chatAccess/$(chatId)/participants/$(request.auth.uid)
      );

      allow create: if request.auth != null
      && firestore.exists(
        /databases/(default)/documents/chatAccess/$(chatId)/participants/$(request.auth.uid)
      )
      && request.resource != null
      && request.resource.size <= 25 * 1024 * 1024
      && request.resource.contentType != null
      && request.resource.contentType.size() > 0;

      allow update: if false;

      allow delete: if request.auth != null
      && firestore.exists(
        /databases/(default)/documents/chatAccess/$(chatId)/participants/$(request.auth.uid)
      );
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}