
{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".read": "auth != null"
        },
        "photoUrl": {
          ".read": "auth != null"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).val() === true",
        "participants": {
          "$uid": {
            ".read": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true",
            ".write": false
          }
        },
        "messages": {
          "$messageId": {
            ".read": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true",
            ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true && ((!data.exists() && newData.exists() && newData.child('senderId').val() === auth.uid && newData.child('read').val() === false) || (data.exists() && !newData.exists() && data.child('senderId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['id', 'senderId', 'text', 'type', 'fileUrl', 'timestamp', 'read'])",
            "id": {
              ".validate": "newData.isString() && newData.val() === $messageId"
            },
            "senderId": {
              ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && newData.val() === data.val()))"
            },
            "text": {
              ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true && root.child('chats').child($chatId).child('messages').child($messageId).child('senderId').val() === auth.uid && newData.isString()",
              ".validate": "newData.isString()"
            },
            "type": {
              ".validate": "newData.isString()"
            },
            "fileUrl": {
              ".validate": "newData.isString()"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            "voiceDuration": {
              ".validate": "newData.isNumber()"
            },
            "read": {
              ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true && root.child('chats').child($chatId).child('messages').child($messageId).child('senderId').val() !== auth.uid && newData.isBoolean() && newData.val() === true && data.val() !== true",
              ".validate": "newData.isBoolean()"
            },
            "edited": {
              ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true && root.child('chats').child($chatId).child('messages').child($messageId).child('senderId').val() === auth.uid && newData.isBoolean() && newData.val() === true",
              ".validate": "newData.isBoolean()"
            },
            "editedAt": {
              ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true && root.child('chats').child($chatId).child('messages').child($messageId).child('senderId').val() === auth.uid && newData.isNumber()",
              ".validate": "newData.isNumber()"
            },
            "uploading": {
              ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true && root.child('chats').child($chatId).child('messages').child($messageId).child('senderId').val() === auth.uid && newData.isBoolean()",
              ".validate": "newData.isBoolean()"
            },
            "uploadProgress": {
              ".write": "auth != null && root.child('chats').child($chatId).child('participants').child(auth.uid).val() === true && root.child('chats').child($chatId).child('messages').child($messageId).child('senderId').val() === auth.uid && newData.isNumber()",
              ".validate": "newData.isNumber()"
            },
            "fileSize": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "user_chats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$otherUserId": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
